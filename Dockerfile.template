{{
	def is_alpine:
		env.variant | index("alpine")
-}}
{{
	def is_4_non_alpine:
		(env.version == "4.4") and (is_alpine | not)
-}}
{{
	def needs_opcache_enable:
		(env.phpVersion | split(".") | map(tonumber)) < [8, 5]
-}}
{{
	def is_development:
		env.development == "1"
-}}
# from https://downloads.joomla.org/technical-requirements
{{ if is_4_non_alpine then ( -}}
FROM php:{{ env.phpVersion }}-{{ env.variant }}-bookworm
{{ ) else ( -}}
FROM php:{{ env.phpVersion }}-{{ env.variant }}
{{ ) end -}}
LABEL maintainer="{{ env.joomlaMaintainers }}"

# Disable remote database security requirements.
ENV JOOMLA_INSTALLATION_DISABLE_LOCALHOST_CHECK=1
{{ if is_alpine then ( -}}
RUN set -eux; \
	apk add --no-cache \
# in theory, docker-entrypoint.sh is POSIX-compliant, but priority is a working, consistent image
		bash \
# Ghostscript is required for rendering PDF previews
		ghostscript \
# Alpine package for "imagemagick" contains ~120 .so files
		imagemagick \
{{ if env.joomlaPackageType == "tar.zst" then ( -}}
# Needed for the zst joomla package
		zstd \
{{ ) else "" end -}}
	;
{{ ) else ( -}}
RUN set -eux; \
	apt-get update; \
	apt-get install -y --no-install-recommends \
# Ghostscript is required for rendering PDF previews
		ghostscript \
{{ if env.joomlaPackageType == "tar.zst" then ( -}}
# Needed for the zst joomla package
		zstd \
{{ ) else "" end -}}
	; \
	rm -rf /var/lib/apt/lists/*
{{ ) end -}}

# install the PHP extensions we need.
RUN set -ex; \
	\
{{ if is_alpine then ( -}}
	apk add --no-cache --virtual .build-deps \
		$PHPIZE_DEPS \
		autoconf \
		bzip2-dev \
		gmp-dev \
		icu-dev \
		freetype-dev \
		imagemagick-dev \
		libjpeg-turbo-dev \
		libmemcached-dev \
		libpng-dev \
		libwebp-dev \
		libzip-dev \
		openldap-dev \
		pcre-dev \
		postgresql-dev \
	; \
{{ ) else ( -}}
	savedAptMark="$(apt-mark showmanual)"; \
	\
	apt-get update; \
	apt-get install -y --no-install-recommends \
		libbz2-dev \
		libgmp-dev \
		libicu-dev \
		libfreetype6-dev \
		libjpeg-dev \
		libldap2-dev \
		libmemcached-dev \
		libmagickwand-dev \
		libpq-dev \
		libpng-dev \
		libwebp-dev \
		libzip-dev \
	; \
{{ ) end -}}
	\
	docker-php-ext-configure gd \
		--with-freetype \
		--with-jpeg \
		--with-webp \
	; \
{{ if is_alpine then ( -}}
	docker-php-ext-configure ldap; \
{{ ) else ( -}}
	debMultiarch="$(dpkg-architecture --query DEB_BUILD_MULTIARCH)"; \
	docker-php-ext-configure ldap --with-libdir="lib/$debMultiarch"; \
{{ ) end -}}
	docker-php-ext-install -j "$(nproc)" \
		bz2 \
		bcmath \
		exif \
		gd \
		gmp \
		intl \
		ldap \
		mysqli \
		pdo_mysql \
		pdo_pgsql \
		pgsql \
		zip \
	; \
{{ if is_alpine then ( -}}
# WARNING: imagick is likely not supported on Alpine: https://github.com/Imagick/imagick/issues/328
{{ ) else "" end -}}
# https://pecl.php.net/package/imagick
	pecl install imagick-{{ env.pecl_imagick }}; \
	docker-php-ext-enable imagick; \
	rm -r /tmp/pear; \
	\
# some misbehaving extensions end up outputting to stdout
	out="$(php -r 'exit(0);')"; \
	[ -z "$out" ]; \
	err="$(php -r 'exit(0);' 3>&1 1>&2 2>&3)"; \
	[ -z "$err" ]; \
	\
	extDir="$(php -r 'echo ini_get("extension_dir");')"; \
	[ -d "$extDir" ]; \
{{ if is_alpine then ( -}}
	\
# pecl will claim success even if one install fails, so we need to perform each install separately
	pecl install APCu-{{ env.pecl_APCu }}; \
	pecl install memcached-{{ env.pecl_memcached }}; \
	pecl install redis-{{ env.pecl_redis }}; \
	\
	docker-php-ext-enable \
		apcu \
		memcached \
		redis \
	; \
	rm -r /tmp/pear; \
	\
	runDeps="$( \
		scanelf --needed --nobanner --format '%n#p' --recursive "$extDir" \
			| tr ',' '\n' \
			| sort -u \
			| awk 'system("[ -e /usr/local/lib/" $1 " ]") == 0 { next } { print "so:" $1 }' \
	)"; \
	apk add --no-network --virtual .joomla-phpexts-rundeps $runDeps; \
	apk del --no-network .build-deps; \
{{ ) else ( -}}
# pecl will claim success even if one install fails, so we need to perform each install separately
	pecl install APCu-{{ env.pecl_APCu }}; \
	pecl install memcached-{{ env.pecl_memcached }}; \
	pecl install redis-{{ env.pecl_redis }}; \
	\
	docker-php-ext-enable \
		apcu \
		memcached \
		redis \
	; \
	rm -r /tmp/pear; \
	\
# reset apt-mark's "manual" list so that "purge --auto-remove" will remove all build dependencies
	apt-mark auto '.*' > /dev/null; \
	apt-mark manual $savedAptMark; \
	ldd "$extDir"/*.so \
		| awk '/=>/ { so = $(NF-1); if (index(so, "/usr/local/") == 1) { next }; gsub("^/(usr/)?", "", so); print so }' \
		| sort -u \
		| xargs -r dpkg-query --search \
		| cut -d: -f1 \
		| sort -u \
		| xargs -rt apt-mark manual; \
	\
	apt-get purge -y --auto-remove -o APT::AutoRemove::RecommendsImportant=false; \
	rm -rf /var/lib/apt/lists/*; \
{{ ) end -}}
	\
	! { ldd "$extDir"/*.so | grep 'not found'; }; \
# check for output like "PHP Warning:  PHP Startup: Unable to load dynamic library 'foo' (tried: ...)
	err="$(php --version 3>&1 1>&2 2>&3)"; \
	[ -z "$err" ]

# set recommended PHP.ini settings
# see https://secure.php.net/manual/en/opcache.installation.php
RUN set -eux; \
{{ if needs_opcache_enable then ( -}}
	docker-php-ext-enable opcache; \
{{ ) else "" end -}}
	{ \
		echo 'opcache.memory_consumption=128'; \
		echo 'opcache.interned_strings_buffer=8'; \
		echo 'opcache.max_accelerated_files=4000'; \
		echo 'opcache.revalidate_freq=2'; \
	} > /usr/local/etc/php/conf.d/opcache-recommended.ini
# set recommended error logging
RUN { \
# https://www.php.net/manual/en/errorfunc.constants.php
		echo 'error_reporting = E_ERROR | E_WARNING | E_PARSE | E_CORE_ERROR | E_CORE_WARNING | E_COMPILE_ERROR | E_COMPILE_WARNING | E_RECOVERABLE_ERROR'; \
		echo 'display_errors = Off'; \
		echo 'display_startup_errors = Off'; \
		echo 'log_errors = On'; \
		echo 'error_log = /dev/stderr'; \
		echo 'log_errors_max_len = 1024'; \
		echo 'ignore_repeated_errors = On'; \
		echo 'ignore_repeated_source = Off'; \
		echo 'html_errors = Off'; \
	} > /usr/local/etc/php/conf.d/error-logging.ini
{{ if env.variant == "apache" then ( -}}

RUN set -eux; \
	a2enmod rewrite expires; \
	\
# https://httpd.apache.org/docs/2.4/mod/mod_remoteip.html
	a2enmod remoteip; \
	{ \
		echo 'RemoteIPHeader X-Forwarded-For'; \
# these IP ranges are reserved for "private" use and should thus *usually* be safe inside Docker
		echo 'RemoteIPInternalProxy 10.0.0.0/8'; \
		echo 'RemoteIPInternalProxy 172.16.0.0/12'; \
		echo 'RemoteIPInternalProxy 192.168.0.0/16'; \
		echo 'RemoteIPInternalProxy 169.254.0.0/16'; \
		echo 'RemoteIPInternalProxy 127.0.0.0/8'; \
	} > /etc/apache2/conf-available/remoteip.conf; \
	a2enconf remoteip; \
# (replace all instances of "%h" with "%a" in LogFormat)
	find /etc/apache2 -type f -name '*.conf' -exec sed -ri 's/([[:space:]]*LogFormat[[:space:]]+"[^"]*)%h([^"]*")/\1%a\2/g' '{}' +
{{ ) else "" end -}}

{{ if is_development then ( -}}
# Development tools are installed only in the matching -dev variant.
ENV COMPOSER_VERSION={{ env.composerVersion }} \
	COMPOSER_SHA256={{ env.composerSha256 }} \
	PIE_VERSION={{ env.pieVersion }} \
	PIE_SHA256={{ env.pieSha256 }} \
	XDEBUG_VERSION={{ env.xdebugVersion }} \
	XDEBUG_SHA256={{ env.xdebugSha256 }} \
	XDEBUG_PACKAGE={{ env.xdebugPackage }} \
	NPM_VERSION={{ env.npmVersion }} \
	NPM_SHA256={{ env.npmSha256 }}

RUN set -eux; \
{{ if is_alpine then ( -}}
	apk add --no-cache \
		git openssh-client patch unzip zip zlib \
		nodejs python3 make g++ \
		mariadb-client postgresql-client sqlite \
		jq rsync less nano; \
	apk add --no-cache --virtual .xdebug-build-deps $PHPIZE_DEPS automake libtool linux-headers zlib-dev; \
{{ ) else ( -}}
	apt-get update; \
	apt-get install -y --no-install-recommends \
		git openssh-client patch unzip zip \
		nodejs python3 make g++ \
		default-mysql-client postgresql-client sqlite3 \
		jq rsync less nano; \
	savedAptMark="$(apt-mark showmanual)"; \
	apt-get install -y --no-install-recommends $PHPIZE_DEPS automake libtool zlib1g-dev; \
{{ ) end -}}
	curl --fail --show-error --location --retry 3 \
		"https://getcomposer.org/download/$COMPOSER_VERSION/composer.phar" -o /usr/local/bin/composer; \
	echo "$COMPOSER_SHA256  /usr/local/bin/composer" | sha256sum -c -; \
	chmod 0755 /usr/local/bin/composer; \
	curl --fail --show-error --location --retry 3 --retry-all-errors \
		--connect-timeout 15 --max-time 300 --proto '=https' --proto-redir '=https' \
		"https://github.com/php/pie/releases/download/$PIE_VERSION/pie.phar" -o /usr/local/bin/pie; \
	echo "$PIE_SHA256  /usr/local/bin/pie" | sha256sum -c -; \
	chmod 0755 /usr/local/bin/pie; \
# Use the distribution's native Node.js on every PHP architecture. npm is
# pinned separately because distribution npm versions can lag Joomla's needs.
	curl --fail --show-error --location --retry 3 \
		"https://registry.npmjs.org/npm/-/npm-$NPM_VERSION.tgz" -o /tmp/npm.tgz; \
	echo "$NPM_SHA256  /tmp/npm.tgz" | sha256sum -c -; \
	mkdir -p /usr/local/lib/node_modules/npm; \
	tar -xzf /tmp/npm.tgz -C /usr/local/lib/node_modules/npm --strip-components=1 --no-same-owner; \
	rm /tmp/npm.tgz; \
	ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm; \
	ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx; \
	node -e 'const npm = require("/usr/local/lib/node_modules/npm/package.json"); const semver = require("/usr/local/lib/node_modules/npm/node_modules/semver"); if (!semver.satisfies(process.version, npm.engines.node)) { throw new Error("Node.js " + process.version + " does not satisfy npm: " + npm.engines.node); }'; \
	curl --fail --show-error --location --retry 3 --retry-all-errors \
		--connect-timeout 15 --max-time 300 --proto '=https' --proto-redir '=https' \
		"$XDEBUG_PACKAGE" -o /tmp/xdebug.tgz; \
	echo "$XDEBUG_SHA256  /tmp/xdebug.tgz" | sha256sum -c -; \
	mkdir /tmp/xdebug; \
	tar -xzf /tmp/xdebug.tgz -C /tmp/xdebug --strip-components=1 --no-same-owner; \
# PIE installs the verified local source, so the build uses exactly the archive
# resolved by versions.sh. Enable it once, after OPcache, using PHP's helper.
	PIE_WORKING_DIRECTORY=/tmp/joomla-pie pie install --no-interaction --no-cache \
		--working-dir=/tmp/xdebug --skip-enable-extension --make-parallel-jobs="$(nproc)"; \
	docker-php-ext-enable --ini-name zz-xdebug.ini xdebug; \
	rm -rf /tmp/xdebug /tmp/xdebug.tgz /tmp/joomla-pie; \
{{ if is_alpine then ( -}}
	apk del --no-network .xdebug-build-deps; \
{{ ) else ( -}}
	apt-mark auto '.*' > /dev/null; \
	apt-mark manual $savedAptMark; \
	ldd "$(php-config --extension-dir)/xdebug.so" \
		| awk '/=>/ { so = $(NF-1); if (index(so, "/usr/local/") == 1) { next }; gsub("^/(usr/)?", "", so); print so }' \
		| sort -u \
		| xargs -r dpkg-query --search \
		| cut -d: -f1 \
		| sort -u \
		| xargs -rt apt-mark manual; \
	apt-get purge -y --auto-remove -o APT::AutoRemove::RecommendsImportant=false; \
	rm -rf /var/lib/apt/lists/*; \
{{ ) end -}}
	php -r 'exit(phpversion("xdebug") === getenv("XDEBUG_VERSION") ? 0 : 1);'; \
	composer --version --no-ansi; \
	pie --version --no-ansi; \
	node --version; \
	test "$(npm --version)" = "$NPM_VERSION"; \
	npx --version

# Xdebug connects out to the IDE; it does not listen on a container port.
ENV JOOMLA_XDEBUG_CLIENT_HOST=host.docker.internal \
	JOOMLA_XDEBUG_CLIENT_PORT=9003 \
	XDEBUG_MODE=develop,debug

COPY zz-joomla-development.ini zz-xdebug-settings.ini /usr/local/etc/php/conf.d/
{{ ) else "" end -}}

VOLUME /var/www/html

# Define Joomla version and expected SHA512 signature
ENV JOOMLA_VERSION={{ env.joomlaVersion }}
ENV JOOMLA_SHA512={{ env.joomlaSha512 }}

# Download package and extract to web volume
RUN set -ex; \
	curl --fail --show-error --location --retry 3 -o joomla.{{ env.joomlaPackageType }} {{ env.joomlaPackage | @sh }}; \
	echo "$JOOMLA_SHA512 *joomla.{{ env.joomlaPackageType }}" | sha512sum -c -; \
	mkdir /usr/src/joomla; \
{{ if env.joomlaPackageType == "tar.zst" then ( -}}
	tar --zstd -xf joomla.tar.zst -C /usr/src/joomla; \
{{ ) else ( -}}
	tar -xf joomla.{{ env.joomlaPackageType }} -C /usr/src/joomla; \
{{ ) end -}}
	rm joomla.{{ env.joomlaPackageType }}; \
	chown -R www-data:www-data /usr/src/joomla

# Copy init scripts
COPY docker-entrypoint.sh /entrypoint.sh
COPY makedb.php /makedb.php

ENTRYPOINT ["/entrypoint.sh"]
{{ if env.variant == "apache" then ( -}}
CMD ["apache2-foreground"]
{{ ) else ( }}
CMD ["php-fpm"]
{{ ) end -}}
